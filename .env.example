# Copy to .env and fill in. The harness reads these from the environment,
# and ./.env is loaded automatically (exported variables win over the file).
#
# Any [OI]-compatible endpoint works. Name YOUR provider -- this file ships no
# endpoint of its own, because a default that pointed at one vendor's service
# would be a silent choice made for every deployment that copied it:
#
#   https://api.your-provider.example/v1
#   http://localhost:11434/v1        (Ollama; any key, e.g. "ollama")
#
# If you would rather configure several providers with aliases and a fallback
# chain, use providers.json + routes.json instead and leave this blank.
AGENT_BASE_URL=

# The key for whichever endpoint you chose above. Get it from that provider's
# dashboard. Paste it straight into .env in the editor -- do NOT paste it into
# an AI chat, a commit, or anywhere it gets logged.
AGENT_API_KEY=

# The model id AS YOUR PROVIDER SPELLS IT. These differ per host: the same
# family may be published under different ids on two gateways. `python run.py
# --check` lists what is available and names the closest match if yours is not.
AGENT_MODEL=

# --- provider keys named by providers.json --------------------------------
# The .env loader whitelists only what the harness declares it needs: every
# AGENT_* setting above, plus each "api_key_env" name in providers.json. Nothing
# else in this file is read, so a project's other credentials stay out of the
# agent's environment. Add a provider to providers.json and its key name is
# picked up here automatically -- no code change, no export per shell.
#
# EXAMPLE_CLOUD_API_KEY=
# SECOND_CLOUD_API_KEY=
# GATEWAY_API_KEY=

# The code the agent works on. Point it at your project's checkout -- locally
# that is often .., in a container it is the mounted read-only volume.
AGENT_PROJECT_ROOT=..

# --- run bounds -----------------------------------------------------------
# The agent stops when the model stops calling tools. MAX_STEPS is the backstop
# so a confused model cannot loop forever and burn tokens.
# 200. The loop stops when the MODEL stops calling tools; this is only the
# backstop. Every observed cut-off of an unattended mission lost work rather
# than saving it: runs that died exactly at the ceiling had typically found a
# defect, fixed it and proved the fix, then had nothing left to deliver or
# report it. Raising the backstop costs nothing on a healthy run -- it finishes
# when the model finishes.
AGENT_MAX_STEPS=200

# Warn the model this many turns before the cut-off, so it writes its answer
# instead of losing fifty steps of research to silence.
AGENT_ANSWER_WARN_STEPS=20

# Wall-clock bound on ONE run, in seconds. MAX_STEPS bounds turns and
# API_TIMEOUT_SEC bounds a single call, so until now nothing bounded the run as
# a whole: a 200-turn ceiling with 6 retries at 120 s per attempt is, worst
# case, days. The scheduler is SEQUENTIAL, so that arithmetic is not academic --
# one slow run silently delays every mission after it, and the console can only
# report the job as overdue. 0 means unbounded. A deployment that schedules
# missions should set it comfortably above a GOOD long run and well below the
# point where the next firing is fiction.
AGENT_MAX_RUN_SEC=0

# How many timeouts ONE route may cause in a run before the chain steps over it.
# A timeout is transient so retrying is right -- but "transient" was unbounded
# per run, which left a slow primary in charge for the entire mission. Counted
# per route, per run, and NEVER persisted: a provider that hiccups tonight is
# still eligible as tomorrow's primary. 0 disables demotion.
AGENT_ROUTE_TIMEOUT_LIMIT=4

AGENT_TOOL_TIMEOUT_SEC=180
AGENT_MAX_TOOL_CHARS=8000

# --- api resilience -------------------------------------------------------
# A busy engine answers 429 "engine_overloaded". Transient errors retry with
# exponential backoff; a bad key or unknown model id fails immediately.
AGENT_API_RETRIES=6
AGENT_API_BACKOFF_SEC=2.0

# Bound ONE model call. Without this the client waits its own ten-minute
# default, and a hung connection looks exactly like a busy model.
AGENT_API_TIMEOUT_SEC=120

# Optional second model, tried only after the primary is exhausted.
# AGENT_FALLBACK_MODEL=vendor-a/model-flash-0731

# 1 = write_file asks before applying. Keep this on until you trust it.
AGENT_CONFIRM_WRITES=1

# run_python confirms ONLY blocks that look like they change state --
# writing/removing files, shelling out, network or external-service calls.
# Confirming every block would train you to click through without reading.
AGENT_CONFIRM_PYTHON_MUTATIONS=1

# --- model behaviour ------------------------------------------------------
# Sent as reasoning_effort. Not all models honour it; measure yours.
AGENT_REASONING_EFFORT=max

# The knob that governs depth on a reasoning model: it spends its completion
# budget thinking before it writes anything.
AGENT_MAX_TOKENS=32000

# 1 = stream tokens as they arrive (console shows the answer forming).
AGENT_STREAM=1

# 1 = build a structural map of the repo (AST for Python) at task start.
AGENT_REPO_MAP=1

# --- generated code -------------------------------------------------------
# One persistent interpreter per task (state survives between calls),
# hard-killed at the timeout so a runaway loop cannot hang the run.
AGENT_PYTHON_TIMEOUT_SEC=60
AGENT_PYTHON_MAX_OUTPUT=6000

# --- memory ---------------------------------------------------------------
# Shared with the editor's Copilot. Auto-discovered from VS Code's
# workspaceStorage; set these to point it elsewhere.
# AGENT_MEMORY_ROOT=C:/path/to/memories
# AGENT_MEMORY_REPO_FILE=C:/path/to/memories/repo/my-project.md
AGENT_MEMORY_HEAD_LINES=120

# --- session log ----------------------------------------------------------
# Always on. Per task: <ts>_<id>.md (readable), <ts>_<id>.jsonl (machine),
# and latest.md pointing at the most recent run.
# AGENT_SESSIONS_DIR=./sessions

# Optional: append every tool call and answer to this JSONL for later review.
AGENT_TRANSCRIPT=

# --- storage retention ----------------------------------------------------
# Everything above grows forever unless bounded, and on a deployment nothing
# else will bound it: runs are scheduled, so the sessions directory gains two
# files per pass and the transcript is opened in append mode and never closed.
#
# Retention runs once per task (see storage.py) and is reported in that task's
# session log, so growth is a trend you can read rather than a disk that fills.
# 0 or negative means unlimited. The newest run's own log is never deleted.
#
#   AGENT_SESSIONS_KEEP=50          runs whose pair is kept
#   AGENT_SESSIONS_MAX_MB=200       total budget across the sessions dir
#   AGENT_TRANSCRIPT_MAX_MB=8       rotate the transcript past this
#   AGENT_TRANSCRIPT_BACKUPS=2      .1 newest ... .N dropped; floored at 1
#
# Memory is REPORTED against its budget, never trimmed: notes are knowledge, not
# a log, and the token cost of the auto-loaded head is already capped by
# AGENT_MEMORY_HEAD_LINES. Retire or consolidate deliberately instead.

# --- web console ----------------------------------------------------------
# The console has NO built-in authentication. Bind to loopback and put an
# authenticated reverse proxy in front of it for any remote access.
AGENT_WEBUI_HOST=127.0.0.1
AGENT_WEBUI_PORT=8787
AGENT_WEBUI_BASE_PATH=/agent

# --- scheduler ------------------------------------------------------------
# The schedule file declares WHAT runs; the state file records WHEN it last
# ran. They are separate because a deployment normally mounts its own config
# read-only (it is reviewed), and stamping last_run back into the schedule file
# would raise inside the poll loop.
# AGENT_SCHEDULE_FILE=./schedule.json
# AGENT_SCHEDULE_STATE_FILE=./sessions/schedule_state.json
# AGENT_SCHEDULE_HOLD=./paused.json

# --- deployment gate ------------------------------------------------------
# The agent stages deploy requests into an outbox; the host applier drains it.
# The agent never has docker or ssh.
# AGENT_DEPLOY_MODE=gated
# AGENT_DEPLOY_ROOT=/path/to/project
# AGENT_DEPLOY_OUTBOX=/path/to/project/.deploy/outbox
# AGENT_DEPLOY_POLICY=/path/to/deploy_policy.json
# AGENT_DEPLOY_APPLIER=/path/to/deploy_applier.py
# AGENT_DEPLOY_ALLOW_RESTART=0
# AGENT_DEPLOY_MAX_FILES=20
# AGENT_DEPLOY_MAX_BYTES=4194304
# AGENT_DEPLOY_MAX_ATTEMPTS=3

# --- recreate guard -------------------------------------------------------
# The guard reads the console's scheduler state to decide whether a recreate
# would kill a run in flight. All settings have CLI equivalents.
# AGENT_RECREATE_CONSOLE=http://127.0.0.1:8787
# AGENT_RECREATE_BASE_PATH=/agent
# AGENT_RECREATE_DOCKER=sudo -n docker
# AGENT_RECREATE_IMAGE=agent-harness:1.0.0
# AGENT_RECREATE_CONTAINER=agent-harness
# AGENT_RECREATE_BUILD_CONTEXT=/opt/agent-harness
# AGENT_RECREATE_COMPOSE_DIR=/opt/project
# AGENT_RECREATE_COMPOSE_FILE=docker-compose.agent.yml
# AGENT_RECREATE_MOUNTS=/agent-data=/opt/agent-data
# AGENT_RECREATE_ENV_PREFIX=AGENT_
# AGENT_RECREATE_CMD=

# --- browser (optional) ---------------------------------------------------
# pip install -r requirements-browser.txt && playwright install chromium
# AGENT_BROWSER_HEADLESS=1
# AGENT_BROWSER_TIMEOUT_MS=30000
# AGENT_BROWSER_SNAPSHOT_CHARS=8000
# AGENT_BROWSER_MAX_REFS=200

# --- images ---------------------------------------------------------------
# AGENT_IMAGES=1
# AGENT_IMAGE_MAX_BYTES=10485760

# --- subagents ------------------------------------------------------------
# AGENT_MAX_SUBAGENT_DEPTH=2
# AGENT_SUBAGENT_TIMEOUT_SEC=120
