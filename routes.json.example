{
  "_comment": "Ordered model-routing fallback chain. First entry is the preferred model; later entries are tried when a route is dead (unknown model, bad key) or exhausted (retries). Override with env AGENT_ROUTES='prov/model,prov/model'. Every name must match an entry in providers.json -- rename the `gateway` block there for your host and mirror it here. The chain below deliberately crosses providers so a whole gateway going dark still leaves a route: two models from one cloud provider, then your own gateway, then a fully local model as the last resort.",
  "routes": [
    {
      "provider": "example-cloud",
      "model": "vendor-model-flash"
    },
    {
      "provider": "example-cloud",
      "model": "vendor-model-pro"
    },
    {
      "provider": "gateway",
      "model": "gateway-fast"
    },
    {
      "provider": "ollama-local",
      "model": "llama3.1"
    }
  ]
}
